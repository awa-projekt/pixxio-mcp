# The mediaspace: its address, e.g. https://example.pixxio.media; /api/v1 may be given or not.
PIXXIO_URL=
# An API key of a pixx.io user who may read what the agents should see.
PIXXIO_API_KEY=

# Optional: a bearer token every MCP request has to carry (Authorization: Bearer <token>).
# Set it whenever the server is reachable by others; without it anyone who reaches it reads the library.
# PIXXIO_MCP_TOKEN=

# Where it listens; --transport, --host and --port override these.
# PIXXIO_MCP_TRANSPORT=http
# PIXXIO_MCP_HOST=127.0.0.1
# PIXXIO_MCP_PORT=8000
